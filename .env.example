# Copy to .env (git-ignored) and fill in. Never commit real keys.
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
# Supabase session-mode / direct connection (port 5432, not the 6543 pooler).
# Loader connects as the `worker` role, the site as `web_reader`.
WORKER_DATABASE_URL=
WEB_DATABASE_URL=
# Football-data.org squads job (worker) and the worker admin API.
# WORKER_ADMIN_TOKEN: openssl rand -hex 32 (same value on the Pi and the website).
WORKER_ADMIN_TOKEN=
# Website -> Pi wake-up through Cloudflare Tunnel + Access (optional).
PI_ADMIN_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
