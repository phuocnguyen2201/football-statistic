# /etc/cloudflared/config.yml
tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  # Only the refresh endpoint is published; protect this hostname with a
  # Cloudflare Access application that allows a service token only.
  - hostname: pi-admin.<your-domain>
    path: ^/refresh$
    service: http://127.0.0.1:8787
  - service: http_status:404
