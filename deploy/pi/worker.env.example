# /etc/football-statistics/worker.env  (owner root:football, mode 640). Never commit real values.
# Session-mode connection (port 5432) as the `worker` role.
WORKER_DATABASE_URL=postgresql://worker.<project-ref>:<password>@<host>:5432/postgres
FOOTBALL_DATA_ORG_KEY=
# Raw API responses stay on the Pi, not in Supabase.
RAW_DIR=/var/lib/football-statistics/raw
RUST_LOG=info
